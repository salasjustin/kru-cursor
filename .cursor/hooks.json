{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "bash .cursor/hooks/hook-trace.sh preToolUse",
        "matcher": "*",
        "timeout": 5
      },
      {
        "command": "bash hooks/mcp-outbound-guard.sh",
        "matcher": "^(CallDynamicTool|MCP:.*)$",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "bash .cursor/hooks/hook-trace.sh beforeMCPExecution",
        "matcher": "*",
        "timeout": 5
      },
      {
        "command": "bash hooks/mcp-outbound-guard.sh",
        "matcher": "*",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
