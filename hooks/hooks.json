{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" sessionStart first-turn.sh",
        "timeout": 60
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" beforeSubmitPrompt prompt-state.sh",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" preToolUse first-turn.sh",
        "matcher": "*",
        "timeout": 15
      },
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" preToolUse require-lead.sh",
        "matcher": "*",
        "timeout": 10
      },
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" preToolUse check-handoff.sh",
        "matcher": "^Task$",
        "timeout": 10
      },
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" preToolUse brainstorm-guard.sh",
        "matcher": "^(Shell|Write|Delete)$",
        "timeout": 10
      },
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" preToolUse seat-guard.sh accessibility-reviewer architecture-reviewer code-reviewer conversion-copywriter dispatch-auditor planner ux-auditor visual-reviewer",
        "matcher": "^(Write|Delete)$",
        "timeout": 10
      },
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" preToolUse mcp-outbound-guard.sh",
        "matcher": "^CallDynamicTool$",
        "timeout": 10,
        "failClosed": true
      },
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" preToolUse mcp-outbound-guard.sh",
        "matcher": "^MCP:.*$",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" beforeMCPExecution mcp-outbound-guard.sh",
        "matcher": "*",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" subagentStart seat-guard.sh accessibility-reviewer architecture-reviewer code-reviewer conversion-copywriter dispatch-auditor planner ux-auditor visual-reviewer",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" postToolUse log-dispatch.sh",
        "matcher": "^Task$",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" subagentStop log-return.sh",
        "timeout": 10,
        "loop_limit": 2
      }
    ],
    "stop": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" stop nudge-audit.sh",
        "timeout": 10,
        "loop_limit": null
      },
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-hook.sh\" stop store-sync.sh stop",
        "timeout": 30
      }
    ]
  }
}
